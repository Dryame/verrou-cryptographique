# Fichier modele - Copier ce fichier en .env et remplir les vraies valeurs
# NE JAMAIS COMMITER LE FICHIER .env

# --- Configuration de la Base de Donnees (PostgreSQL) ---
POSTGRES_USER=verrou_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=verrou_db
DATABASE_URL=postgresql+asyncpg://verrou_user:change_me_in_production@db:5432/verrou_db

# --- Configuration de l'API ---
# URL de votre frontend en production (ex: https://verrou.mondomaine.com)
FRONTEND_URL=http://localhost:5173

# Cle secrete generee aleatoirement pour les signatures et tokens
SECRET_KEY=votre_cle_secrete_generee_ici

# Environnement d'execution (development ou production)
ENVIRONMENT=development
